<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryLightColor"
    tools:context=".view.payment.result.PaymentStatusActivity">

    <ScrollView
        android:id="@+id/payment_status_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_3m"
            android:paddingTop="@dimen/ui_3m"
            android:paddingEnd="@dimen/ui_3m"
            android:paddingBottom="@dimen/ui_4m">

            <TextView
                android:id="@+id/text_payment_status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/point_smartapp_demo_app_payment_status_title"
                android:textColor="@color/primaryTextColor"
                android:textSize="@dimen/ui_title_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_1m"
                android:text="@string/point_smartapp_demo_app_payment_status_description"
                android:textColor="@color/grayLight"
                android:textSize="@dimen/ui_body_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_3m"
                android:text="@string/point_smartapp_demo_app_payment_status_query_type"
                android:textColor="@color/primaryTextColor"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/payment_status_query_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_1m"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_local_payment_status"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/point_smartapp_demo_app_payment_status_local"
                    android:textColor="@color/point_smartapp_demo_app_payment_status_toggle_text"
                    app:backgroundTint="@color/point_smartapp_demo_app_payment_status_toggle_background"
                    app:strokeColor="@color/primaryColor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_online_payment_status"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="@string/point_smartapp_demo_app_payment_status_online"
                    android:textColor="@color/point_smartapp_demo_app_payment_status_toggle_text"
                    app:backgroundTint="@color/point_smartapp_demo_app_payment_status_toggle_background"
                    app:strokeColor="@color/primaryColor" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_input_payment_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_2m"
                android:hint="@string/point_smartapp_demo_app_lab_hind_external_reference"
                app:counterEnabled="true"
                app:counterMaxLength="128"
                app:counterTextColor="@color/grayLight"
                app:helperText="@string/point_smartapp_demo_app_payment_status_reference_helper"
                app:helperTextTextColor="@color/grayLight"
                app:hintTextColor="@color/grayLight">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_input_payment_status_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLength="128"
                    android:singleLine="true"
                    android:textColor="@color/primaryTextColor" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_search_payment_status"
                style="@style/point_smartapp_demo_appTheme.ButtonTheme.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_2m"
                android:enabled="false"
                android:text="@string/point_smartapp_demo_app_payment_status_search" />

            <ProgressBar
                android:id="@+id/payment_status_progress"
                android:layout_width="@dimen/ui_5m"
                android:layout_height="@dimen/ui_5m"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ui_2m"
                android:contentDescription="@string/point_smartapp_demo_app_payment_status_loading"
                android:indeterminateTint="@color/primaryColor"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_payment_status_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_2m"
                android:accessibilityLiveRegion="polite"
                android:background="@color/dark_grey"
                android:padding="@dimen/ui_2m"
                android:textColor="@color/paymentStatusErrorTextColor"
                android:textSize="@dimen/ui_body_size"
                android:visibility="gone"
                tools:text="Payment not found"
                tools:visibility="visible" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_payment_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_2m"
                android:visibility="gone"
                app:cardBackgroundColor="@color/dark_grey"
                app:cardCornerRadius="@dimen/ui_2m"
                app:cardElevation="@dimen/ui_050m"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_2m">

                    <TextView
                        android:id="@+id/text_payment_status_result_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primaryColor"
                        android:textSize="@dimen/ui_medium_body_size"
                        android:textStyle="bold"
                        tools:text="Approved" />

                    <TextView
                        android:id="@+id/text_payment_status_result_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_050m"
                        android:textColor="@color/grayLight"
                        android:textSize="@dimen/ui_body_size"
                        tools:text="Online data returned by the SDK" />

                    <LinearLayout
                        android:id="@+id/payment_status_result_sections"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_1m"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back_to_home"
                style="@style/point_smartapp_demo_appTheme.ButtonTheme.ButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_3m"
                android:text="@string/point_smartapp_demo_app_lab_back_to_home_action" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
