<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryDarkColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ui_3m">

        <TextView
            android:id="@+id/sso_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/point_smartapp_demo_app_sso_title"
            android:textSize="24sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_3m"
            app:cardBackgroundColor="@color/dark_grey"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ui_3m">

                <ProgressBar
                    android:id="@+id/sso_progress_bar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/ui_2m"
                    android:importantForAccessibility="no"
                    android:indeterminateTint="@color/primaryColor"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sso_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ui_2m"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/request_sso_button"
                    style="@style/point_smartapp_demo_appTheme.ButtonTheme.ButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/point_smartapp_demo_app_sso_request" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_to_home_button"
            style="@style/point_smartapp_demo_appTheme.ButtonTheme.ButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_3m"
            android:minHeight="48dp"
            android:text="@string/point_smartapp_demo_app_lab_back_to_home_action" />
    </LinearLayout>
</ScrollView>
